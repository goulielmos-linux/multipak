[Desktop Entry]
Type=Application
Name=MultiPak Application Installer
Name[pt_BR]=Instalador de Aplicativos — MultiPak
Comment=Install RPM, DEB, Arch Linux, AppImage and Android applications
Comment[pt_BR]=Instale aplicativos RPM, DEB, Arch Linux, AppImage e Android
Exec=multipak-installer %f
Icon=io.github.multipak.installer
Terminal=false
Categories=System;PackageManager;
MimeType=application/x-rpm;application/vnd.debian.binary-package;application/x-deb;application/x-archlinux-package;application/vnd.appimage;application/x-iso9660-appimage;application/x-appimage;application/x-multipak-appimage;application/vnd.android.package-archive;application/vnd.apkm;application/x-apks;application/xapk-package-archive;
StartupNotify=true
StartupWMClass=io.github.multipak.installer
NoDisplay=true
